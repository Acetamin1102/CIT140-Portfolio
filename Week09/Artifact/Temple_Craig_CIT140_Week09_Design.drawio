  <diagram id="w09-0" name="01 Choice">
    <mxGraphModel dx="1156" dy="848" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" value="CIT 140 Week 9 — 01 Choice" vertex="1">
          <mxGeometry height="50" width="1000" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1" value="Archive Problem: The current process depends on a desk clerk copying a paper slip into a shared spreadsheet, then sending the paper slip to a runner. The issue is that the request can move forward before anyone catches a missing destination or missing information needed by the destination keeper. By the time the keeper discovers a problem, the request has already been&#xa;handed off and has to come back to the clerk for clarification. Manually entering the same information also leaves room for human error, and unrestricted spreadsheet editing would be another concern if permissions are not controlled. We have not been given an actual error rate or time baseline, so these are process risks rather than measured results.&#xa;&#xa;Boundary: This design starts when a requester gives the desk a request and ends when the correct keeper acknowledges receipt, or the request is returned for clarification. Retrieving records, processing&#xa;payments, changing archive equipment" vertex="1">
          <mxGeometry height="260" width="1020" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-27" parent="1" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedHeader=1;tableRender=collapsed;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1" value="Options Comparison" vertex="1">
          <mxGeometry height="480" width="521" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-28" parent="MVATHw5-VSXownZHb5dM-27" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" value="" vertex="1">
          <mxGeometry height="47" width="521" y="30" as="geometry" />
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-29" parent="MVATHw5-VSXownZHb5dM-28" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontStyle=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Options Considered" vertex="1">
