        </mxCell>
        <mxCell id="GlCiMWkzsJfyI1Iwu1g1-15" parent="GlCiMWkzsJfyI1Iwu1g1-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=light-dark(#000000,#000000);overflow=hidden;fillColor=light-dark(#0050EF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);fontSize=10;" value="Stops incomplete or&lt;br/&gt;mismatched requests&lt;br/&gt;before they reach the&lt;br/&gt;runner.&amp;nbsp;" vertex="1">
          <mxGeometry height="83" width="233" x="465" as="geometry">
