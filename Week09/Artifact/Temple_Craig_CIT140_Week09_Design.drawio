        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-30" parent="MVATHw5-VSXownZHb5dM-28" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Option A- Improve existing workflow&amp;nbsp;" vertex="1">
