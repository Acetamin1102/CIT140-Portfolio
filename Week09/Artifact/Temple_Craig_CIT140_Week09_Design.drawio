          <mxGeometry height="84" width="233" x="465" as="geometry">
            <mxRectangle height="84" width="233" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GlCiMWkzsJfyI1Iwu1g1-11" parent="GlCiMWkzsJfyI1Iwu1g1-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=light-dark(#000000,#000000);overflow=hidden;fillColor=light-dark(#0050EF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);fontSize=10;" value="Open N01, verify ID,&lt;br/&gt;requester, contact, reference,&lt;br/&gt;destination and summary;&lt;br/&gt;find the same ID at handoff.&amp;nbsp;" vertex="1">
          <mxGeometry height="84" width="232" x="698" as="geometry">
