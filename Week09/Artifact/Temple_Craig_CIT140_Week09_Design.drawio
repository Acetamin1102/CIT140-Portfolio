        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-37" parent="MVATHw5-VSXownZHb5dM-36" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontStyle=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Existing limits" vertex="1">
          <mxGeometry height="135" width="120" as="geometry">
            <mxRectangle height="135" width="120" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-38" parent="MVATHw5-VSXownZHb5dM-36" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Keeps familiar spreadsheet and handoff process checked by staff.&amp;nbsp;" vertex="1">
          <mxGeometry height="135" width="202" x="120" as="geometry">
            <mxRectangle height="135" width="202" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-39" parent="MVATHw5-VSXownZHb5dM-36" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Uses existing directory as the source, any lookup method or locked down fields would need to be designed and scalable.&amp;nbsp;" vertex="1">
          <mxGeometry height="135" width="199" x="322" as="geometry">
            <mxRectangle height="135" width="199" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-40" parent="MVATHw5-VSXownZHb5dM-27" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" value="" vertex="1">
          <mxGeometry height="133" width="521" y="347" as="geometry" />
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-41" parent="MVATHw5-VSXownZHb5dM-40" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontStyle=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Tradeoff" vertex="1">
          <mxGeometry height="133" width="120" as="geometry">
            <mxRectangle height="133" width="120" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-42" parent="MVATHw5-VSXownZHb5dM-40" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Lower disruption and probably less training, but still manual process. No costs identified but could be cost savings.&amp;nbsp;" vertex="1">
          <mxGeometry height="133" width="202" x="120" as="geometry">
            <mxRectangle height="133" width="202" as="alternateBounds" />
          </mxGeometry>
