          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-34" parent="MVATHw5-VSXownZHb5dM-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Standardized columns and manual checks could improve efficiency and tracking, but still leaves room for human error.&amp;nbsp;" vertex="1">
          <mxGeometry height="135" width="202" x="120" as="geometry">
            <mxRectangle height="135" width="202" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-35" parent="MVATHw5-VSXownZHb5dM-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Required fields in an interface, directory checks, and role specific views can guide workflow and reduce human error.&amp;nbsp;&amp;nbsp;" vertex="1">
          <mxGeometry height="135" width="199" x="322" as="geometry">
            <mxRectangle height="135" width="199" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
