  <diagram id="w09-2" name="03 Traceability">
    <mxGraphModel dx="1245" dy="677" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;fillColor=#fa6800;strokeColor=#C73500;fontColor=#000000;" value="CIT 140 Week 9 — 03 Traceability" vertex="1">
          <mxGeometry height="40" width="1000" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" value="Current Process: Today the clerk copies a paper slip into a spreadsheet without requiredfield checks, then seals it and sends it to the outgoing tray. The runner picks the destination from the slip, and the keeper may be the first person to catch a missing or incorrect detail. Status is free text, and it does not consistently identify who changed it or when. Under the proposal, the desk validates required fields and the reference/ destination combination before dispatch. Requests that fail stay with the desk until corrected and rechecked. Each handoff and status change would be recorded, and role-based access would separate contact details from delivery information. &#xa;&#xa;Data quality: Required fields, directory matching, correction history, and revalidation reduce opportunities for incomplete or conflicting data. The interface should not quietly replace an incorrect reference. &#xa;&#xa;Access: Desk contact details would be restricted by role, including on exported or printed runner slips. Actual permission enforcement, audit logging, and directory behavior still need to be built and tested." vertex="1">
          <mxGeometry height="160" width="1000" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="GlCiMWkzsJfyI1Iwu1g1-1" parent="1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedHeader=1;tableRender=collapsed;" value="" vertex="1">
          <mxGeometry height="580" width="930" x="100" y="250" as="geometry" />
        </mxCell>
        <mxCell id="GlCiMWkzsJfyI1Iwu1g1-2" parent="GlCiMWkzsJfyI1Iwu1g1-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=light-dark(#000000,#000000);collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;swimlaneFillColor=light-dark(#0050EF,#FFFFFF);" value="" vertex="1">
          <mxGeometry height="82" width="930" as="geometry" />
        </mxCell>
