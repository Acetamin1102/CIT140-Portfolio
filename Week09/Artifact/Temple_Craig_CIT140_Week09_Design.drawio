<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="w09-0" name="01 Choice"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CIT 140 Week 9 — 01 Choice" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/></mxCell><mxCell id="prompt" value="Name the archive problem and boundary. Compare approaches A and B against needs and limits. Choose one and explain a tradeoff." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="w09-1" name="02 Design"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CIT 140 Week 9 — 02 Design" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/></mxCell><mxCell id="prompt" value="Proposed model OR prototype. Add roles, information, labeled decisions/states, normal route, clarification and correction route. Include a text route description." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="w09-2" name="03 Traceability"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CIT 140 Week 9 — 03 Traceability" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/></mxCell><mxCell id="prompt" value="For EACH AR-01 through AR-06: source / design element or page / reason / proposed check. Explain current vs proposed, data quality and role access." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="w09-3" name="04 Walkthroughs"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CIT 140 Week 9 — 04 Walkthroughs" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/></mxCell><mxCell id="prompt" value="N01: actual route / expected outcome / gap / revision or supported no-change. E01: route before and after supplied correction / outcome / gap / revision. Add assumptions, risks and next checks." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
