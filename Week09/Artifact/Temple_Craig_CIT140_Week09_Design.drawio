          <mxGeometry height="115" width="134" as="geometry">
            <mxRectangle height="115" width="134" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-42" parent="MVATHw5-VSXownZHb5dM-40" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Lower disruption and probably less training, but still manual process. No costs identified but could be cost savings.&amp;nbsp;" vertex="1">
          <mxGeometry height="115" width="224" x="134" as="geometry">
            <mxRectangle height="115" width="224" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MVATHw5-VSXownZHb5dM-43" parent="MVATHw5-VSXownZHb5dM-40" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="More standardized workflow reducting human error and intervention but requires design, testing, implementation, training of staff, and approval. No estimates for cost savings.&amp;nbsp;" vertex="1">
          <mxGeometry height="115" width="222" x="358" as="geometry">
            <mxRectangle height="115" width="222" as="alternateBounds" />
