        <mxCell id="MVATHw5-VSXownZHb5dM-38" parent="MVATHw5-VSXownZHb5dM-36" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=light-dark(#FFFFFF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);gradientColor=light-dark(#000000,#A9C4EB);" value="Keeps familiar spreadsheet and handoff process checked by staff.&amp;nbsp;" vertex="1">
          <mxGeometry height="117" width="224" x="134" as="geometry">
