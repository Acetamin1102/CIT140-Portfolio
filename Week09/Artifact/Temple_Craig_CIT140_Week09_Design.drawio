          <mxGeometry height="83" width="930" y="166" as="geometry" />
        </mxCell>
        <mxCell id="GlCiMWkzsJfyI1Iwu1g1-13" parent="GlCiMWkzsJfyI1Iwu1g1-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=light-dark(#000000,#000000);overflow=hidden;fillColor=light-dark(#0050EF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);fontSize=10;fontStyle=0" value="&lt;div&gt;AR-02 — Desk&lt;/div&gt;&lt;div&gt;clerk, W09-S02/&lt;/div&gt;&lt;div&gt;S01&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="83" width="233" as="geometry">
            <mxRectangle height="83" width="233" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GlCiMWkzsJfyI1Iwu1g1-14" parent="GlCiMWkzsJfyI1Iwu1g1-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=light-dark(#000000,#000000);overflow=hidden;fillColor=light-dark(#0050EF,#FFFFFF);pointerEvents=1;fontColor=light-dark(#000000,#000000);fontSize=10;" value="Validation decision step&lt;br/&gt;2; clarification step 2a&amp;nbsp;" vertex="1">
          <mxGeometry height="83" width="232" x="233" as="geometry">
