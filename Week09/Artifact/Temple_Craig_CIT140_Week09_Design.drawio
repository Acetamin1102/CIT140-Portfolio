  <diagram id="w09-1" name="02 Design">
    <mxGraphModel dx="1497" dy="814" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;fillColor=#fa6800;strokeColor=#C73500;fontColor=#000000;" value="CIT 140 Week 9 — 02 Design" vertex="1">
          <mxGeometry height="40" width="1000" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" value="Proposed Workflow Description&#xa;&#xa;My proposed design uses a small request interface instead of manually entering information into a shared spreadsheet. The desk clerk would enter the request, and the system would assign a request ID and validate the required information against the existing directory before allowing it to be dispatched.&#xa;If everything checks out, the request is marked Ready for Dispatch and passed to the runner. The runner delivers it to the correct keeper, who acknowledges receipt. Each status change records who made the change and when.&#xa;If information is missing or incorrect, the system marks the request Awaiting Clarification and prevents dispatch. The desk clerk would contact the requester, record the correction, and submit the request for validation again. The original information would remain in the request history.&#xa;This approach should reduce opportunities for human error while maintaining accountability throughout the process. However, it is only a proposed design and would still require development, testing, training, and approval before implementation." vertex="1">
          <mxGeometry height="260" width="1000" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-13" edge="1" parent="1" source="zR6N6gG6pXpfrKq2ToZN-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;fillColor=#cce5ff;strokeColor=#36393d;" target="zR6N6gG6pXpfrKq2ToZN-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#cce5ff;strokeColor=#36393d;" value="Desk Clerk: Receives Request&lt;div&gt;Enter requester, contact, reference, destination, and summary into the proposed interface. System assigns a Request ID.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="500" x="280" y="340" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#cce5ff;strokeColor=#36393d;" value="2. System: Validate Request&lt;div&gt;Are required fields complete and does the reference match the destination directory?&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="500" x="280" y="460" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-12" edge="1" parent="1" source="zR6N6gG6pXpfrKq2ToZN-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="zR6N6gG6pXpfrKq2ToZN-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="Ready for Dispatch:&lt;div&gt;System records status and prepares runner view without contact details.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="290" y="570" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-9" edge="1" parent="1" source="zR6N6gG6pXpfrKq2ToZN-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="zR6N6gG6pXpfrKq2ToZN-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="&lt;div&gt;Awaiting Clarification&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;System records missing or invalid information. Dispatch blocked.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="560" y="570" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-11" edge="1" parent="1" source="zR6N6gG6pXpfrKq2ToZN-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="zR6N6gG6pXpfrKq2ToZN-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="&lt;div&gt;Runner Delivers&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Runner receives ID, reference and destination. Status becomes In Delivery.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="290" y="650" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-10" edge="1" parent="1" source="zR6N6gG6pXpfrKq2ToZN-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="zR6N6gG6pXpfrKq2ToZN-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="&lt;div&gt;Clerk Requests Correction&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Desk clerk contacts requester, records corrected details and preserves history.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="560" y="650" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="&lt;div&gt;Keeper Acknowledges&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Keeper confirms receipt. System records staff member, time and Received status.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="290" y="730" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="&lt;div&gt;Revalidate Request&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;System checks corrected details. If valid, return to dispatch. Otherwise, remain Awaiting Clarification.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="560" y="730" as="geometry" />
        </mxCell>
        <mxCell id="zR6N6gG6pXpfrKq2ToZN-14" edge="1" parent="1" source="zR6N6gG6pXpfrKq2ToZN-2" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;labelPadding=0 4;endWidth=52;endSize=12;fillColor=#60a917;strokeColor=#2D7600;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" target="zR6N6gG6pXpfrKq2ToZN-3" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
